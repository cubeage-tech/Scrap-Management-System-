generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// =====================================================
// ENUMS
// =====================================================

enum BusinessType {
  INDUSTRY
  DEALER
  BUYER
  PLATFORM
}

enum AccountState {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  INDUSTRY
  DEALER
  BUYER
}

enum SellingMode {
  QUOTATION
  AUCTION
  TENDER
}

enum ScrapStatus {
  AVAILABLE
  PARTIALLY_LISTED
  FULLY_LISTED
  SOLD_OUT
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  BIDDING_CLOSED
  OFFER_ACCEPTED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum QuotationStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  EXTENDED
  CLOSED_WITH_WINNER
  CLOSED_NO_WINNER
  CANCELLED
}

enum BidStatus {
  PLACED
  OUTBID
  WINNING
  WON
  LOST
}

enum SaleStatus {
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum PaymentTerms {
  ADVANCE
  ON_PICKUP
  DAYS_15
  DAYS_30
  DAYS_45
}

enum NotificationType {
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  NEW_REGISTRATION

  LISTING_PUBLISHED
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  OFFER_WITHDRAWN

  OUTBID
  AUCTION_STARTING
  AUCTION_EXTENDED
  AUCTION_WON
  AUCTION_LOST
  AUCTION_NO_WINNER

  TENDER_REVEALED

  LISTING_EXPIRED
  SALE_ACCEPTED
  SALE_COMPLETED

  INVENTORY_ADDED
  INVENTORY_UPDATED
}


// =====================================================
// ORGANISATIONS
// =====================================================

model Organisation {
  id            String         @id @default(uuid())
  companyName   String
  businessType  BusinessType
  gstNumber     String?        @unique
  address       String
  city          String
  state         String
  pincode       String

  contactName   String
  contactPhone  String

  accountState  AccountState   @default(PENDING)
  rejectReason  String?
  approvedAt    DateTime?

  approvedByUserId String?
  approvedBy       User?       @relation("OrganisationApprovedBy", fields: [approvedByUserId], references: [id])

  users         User[]

  // Marketplace relationships
  buyerInterests BuyerInterest[]
  scrapRecords   ScrapRecord[]  @relation("ScrapOwner")
  quotations     Quotation[]    @relation("QuotationBuyer")
  bids           Bid[]          @relation("Bidder")
  salesAsSeller  Sale[]         @relation("SaleSeller")
  salesAsBuyer   Sale[]         @relation("SaleBuyer")

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([businessType, accountState])
  @@index([accountState])
}


// =====================================================
// USERS
// =====================================================

model User {
  id              String        @id @default(uuid())

  organisationId  String
  organisation    Organisation  @relation(fields: [organisationId], references: [id])

  contactName     String

  email           String        @unique

  phoneNumber     String

  password        String

  role            UserRole

  isActive        Boolean       @default(false)

  lastLoginAt     DateTime?

  // Authentication
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]

  // Organisation approval
  approvedOrganisations Organisation[] @relation("OrganisationApprovedBy")

  // Inventory
  createdScrapRecords ScrapRecord[] @relation("ScrapCreatedBy")

  // Marketplace
  createdListings Listing[] @relation("ListingCreatedBy")

  // Quotations
  submittedQuotations Quotation[] @relation("QuotationSubmittedBy")

  // Bids
  placedBids Bid[] @relation("BidPlacedBy")

  // Sales
  acceptedSales  Sale[] @relation("SaleAcceptedBy")
  completedSales Sale[] @relation("SaleCompletedBy")

  // Commission
  createdCommissionSettings CommissionSetting[] @relation("CommissionCreatedBy")

  // Notifications
  notifications Notification[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([role])
}


// =====================================================
// AUTH
// =====================================================

model PasswordResetToken {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String

  expiresAt DateTime

  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}


model RefreshToken {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}


// =====================================================
// CATALOGUE
// =====================================================

model Category {
  id        String  @id @default(uuid())

  name      String

  parentId  String?
  parent    Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")

  isActive  Boolean @default(true)

  buyerInterests BuyerInterest[]

  scrapRecords ScrapRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
}


// =====================================================
// BUYER INTERESTS
// =====================================================

model BuyerInterest {
  id String @id @default(uuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())

  @@unique([organisationId, categoryId])
  @@index([organisationId])
  @@index([categoryId])
}


// =====================================================
// SCRAP INVENTORY
// =====================================================

model ScrapRecord {
  id String @id @default(uuid())

  // Organisation that owns the physical scrap
  ownerId String
  owner   Organisation @relation("ScrapOwner", fields: [ownerId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  description String?

  condition String?

  locationLabel String?

  // Physical quantity
  totalQuantityKg Decimal

  // Quantity allocated to marketplace listings
  listedQuantityKg Decimal @default(0)

  // Quantity already sold
  soldQuantityKg Decimal @default(0)

  // Remaining quantity
  availableQuantityKg Decimal

  status ScrapStatus @default(AVAILABLE)

  // If this inventory originated from a purchase
  sourceSaleId String? @unique
  sourceSale   Sale? @relation("SaleSourceInventory", fields: [sourceSaleId], references: [id])

  createdByUserId String?
  createdByUser   User? @relation("ScrapCreatedBy", fields: [createdByUserId], references: [id])

  images ScrapImage[]

  listings Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([categoryId])
  @@index([sourceSaleId])
}


// =====================================================
// SCRAP IMAGES
// =====================================================

model ScrapImage {
  id String @id @default(uuid())

  scrapRecordId String
  scrapRecord   ScrapRecord @relation(fields: [scrapRecordId], references: [id], onDelete: Cascade)

  url String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([scrapRecordId])
}


// =====================================================
// MARKETPLACE LISTINGS
// =====================================================

model Listing {
  id String @id @default(uuid())

  scrapRecordId String
  scrapRecord   ScrapRecord @relation(fields: [scrapRecordId], references: [id])

  sellingMode SellingMode

  // Quantity being sold through this listing
  quantityKg Decimal

  expectedPricePerKg Decimal?

  closesAt DateTime?

  status ListingStatus @default(DRAFT)

  publishedAt DateTime?

  closedAt DateTime?

  createdByUserId String?
  createdByUser   User? @relation("ListingCreatedBy", fields: [createdByUserId], references: [id])

  quotations Quotation[]

  auction Auction?

  sales Sale?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scrapRecordId])
  @@index([status, sellingMode])
  @@index([status, closesAt])
}


// =====================================================
// QUOTATIONS
// =====================================================

model Quotation {
  id String @id @default(uuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  // Organisation making the offer
  buyerId String
  buyer   Organisation @relation("QuotationBuyer", fields: [buyerId], references: [id])

  pricePerKg Decimal

  quantityKg Decimal

  totalValue Decimal

  paymentTerms PaymentTerms?

  note String?

  // Used for Tender
  isSealed Boolean @default(false)

  revealedAt DateTime?

  validUntil DateTime?

  status QuotationStatus @default(SUBMITTED)

  submittedByUserId String?
  submittedByUser   User? @relation("QuotationSubmittedBy", fields: [submittedByUserId], references: [id])

  sale Sale?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, status])
  @@index([buyerId, status])
  @@index([listingId])
}


// =====================================================
// AUCTIONS
// =====================================================

model Auction {
  id String @id @default(uuid())

  listingId String @unique
  listing   Listing @relation(fields: [listingId], references: [id])

  startsAt DateTime

  endsAt DateTime

  startingPricePerKg Decimal

  reservePricePerKg Decimal?

  minIncrement Decimal

  extensionWindowMin Int @default(5)

  extensionMinutes Int @default(5)

  extensionCount Int @default(0)

  status AuctionStatus @default(SCHEDULED)

  currentHighestBidId String? @unique
  currentHighestBid   Bid? @relation("CurrentHighestBid", fields: [currentHighestBidId], references: [id])

  winningBidId String? @unique
  winningBid   Bid? @relation("WinningBid", fields: [winningBidId], references: [id])

  bidCount Int @default(0)

  bidderCount Int @default(0)

  closedAt DateTime?

  bids Bid[] @relation("AuctionBids")

  sale Sale?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
  @@index([status, endsAt])
}


// =====================================================
// BIDS
// =====================================================

model Bid {
  id String @id @default(uuid())

  auctionId String
  auction   Auction @relation("AuctionBids", fields: [auctionId], references: [id], onDelete: Cascade)

  bidderId String
  bidder   Organisation @relation("Bidder", fields: [bidderId], references: [id])

  pricePerKg Decimal

  totalValue Decimal

  sequence Int

  status BidStatus @default(PLACED)

  placedByUserId String?
  placedByUser   User? @relation("BidPlacedBy", fields: [placedByUserId], references: [id])

  placedAt DateTime @default(now())

  winningForAuction Auction? @relation("WinningBid")

  currentHighestForAuction Auction? @relation("CurrentHighestBid")

  sale Sale?

  @@unique([auctionId, sequence])
  @@index([auctionId, pricePerKg])
  @@index([bidderId])
  @@index([placedAt])
}


// =====================================================
// SALES / DEALS
// =====================================================

model Sale {
  id String @id @default(uuid())

  // One listing can create only one final sale
  listingId String @unique
  listing   Listing @relation(fields: [listingId], references: [id])

  // Sale can originate from quotation
  quotationId String? @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  // OR auction bid
  bidId String? @unique
  bid   Bid? @relation(fields: [bidId], references: [id])

  // Auction reference
  auctionId String? @unique
  auction   Auction? @relation(fields: [auctionId], references: [id])

  sellerId String
  seller   Organisation @relation("SaleSeller", fields: [sellerId], references: [id])

  buyerId String
  buyer   Organisation @relation("SaleBuyer", fields: [buyerId], references: [id])

  sellerType BusinessType?

  quantityKg Decimal

  pricePerKg Decimal

  totalValue Decimal

  commissionRate Decimal?

  commissionAmount Decimal?

  status SaleStatus @default(ACCEPTED)

  acceptedByUserId String?
  acceptedByUser   User? @relation("SaleAcceptedBy", fields: [acceptedByUserId], references: [id])

  completedByUserId String?
  completedByUser   User? @relation("SaleCompletedBy", fields: [completedByUserId], references: [id])

  completedAt DateTime?

  cancelledAt DateTime?

  // Inventory created from this sale
  sourceInventory ScrapRecord? @relation("SaleSourceInventory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId, status])
  @@index([buyerId, status])
  @@index([completedAt])
}


// =====================================================
// PLATFORM COMMISSION
// =====================================================

model CommissionSetting {
  id String @id @default(uuid())

  sellerType BusinessType

  ratePercent Decimal

  effectiveFrom DateTime

  createdById String?
  createdBy   User? @relation("CommissionCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([sellerType, effectiveFrom])
}


// =====================================================
// NOTIFICATIONS
// =====================================================

model Notification {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id])

  type NotificationType

  title String?

  message String?

  entityType String?

  entityId String?

  isRead Boolean @default(false)

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}