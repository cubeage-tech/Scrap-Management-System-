# # ==========================================
# # SERVER CONFIGURATION
# # ==========================================

# NODE_ENV=development
# PORT=5000
# CLIENT_URLS=http://localhost:5173,http://localhost:5174

# # ==========================================
# # DATABASE CONFIGURATION (PostgreSQL)
# # ==========================================

# # DB_HOST=localhost
# # DB_PORT=5432
# # DB_NAME=scrap_management
# # DB_USER=postgres
# # DB_PASSWORD=root
# # DB_SSL=false

# # Prisma Database URL
# DATABASE_URL="postgresql://postgres:root@localhost:5432/scrap_management?schema=public"

# # ==========================================
# # JWT CONFIGURATION
# # ==========================================

# JWT_SECRET=your_super_secret_jwt_key_change_this
# JWT_EXPIRES_IN=7d

# # ==========================================
# # BCRYPT
# # ==========================================

# BCRYPT_SALT_ROUNDS=10

# # ==========================================
# # SEED ADMIN (npm run seed:admin) — all optional, have defaults
# # ==========================================

# ADMIN_EMAIL=admin@smartscrap.ai
# ADMIN_PASSWORD=Admin@12345
# ADMIN_NAME=Platform Admin
# ADMIN_PHONE=9999999999

# # ==========================================
# # EMAIL / SMTP (for password reset)
# # Leave blank in dev — reset link is printed to console instead
# # ==========================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password
# SMTP_FROM=SmartScrap AI <noreply@smartscrap.ai>
# CLIENT_BASE_URL=http://localhost:5173