# # ==========================================
# # SERVER CONFIGURATION
# # ==========================================

# NODE_ENV=development
# PORT=5000
# CLIENT_URL=http://localhost:5173

# # ==========================================
# # DATABASE CONFIGURATION (PostgreSQL)
# # ==========================================

# # DB_HOST=localhost
# # DB_PORT=5432
# # DB_NAME=scrap_management
# # DB_USER=postgres
# # DB_PASSWORD=root
# # DB_SSL=false

# # Prisma Database URL
# DATABASE_URL="postgresql://postgres:root@localhost:5432/scrap_management?schema=public"

# # ==========================================
# # JWT CONFIGURATION
# # ==========================================

# JWT_SECRET=your_super_secret_jwt_key_change_this
# JWT_EXPIRES_IN=7d

# # ==========================================
# # BCRYPT
# # ==========================================

# BCRYPT_SALT_ROUNDS=10

# # ==========================================
# # SEED ADMIN (npm run seed:admin) — all optional, have defaults
# # ==========================================

# ADMIN_EMAIL=admin@smartscrap.ai
# ADMIN_PASSWORD=Admin@12345
# ADMIN_NAME=Platform Admin
# ADMIN_PHONE=9999999999